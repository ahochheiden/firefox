JAR_MANIFESTS += ["jar.mn"]

LOCALIZED_JAR_SOURCES = {
    "android_marketplace": {
        "default": "en-US",
        "es*": "es-ES",
        "de": "de",
    },
    "ios_marketplace": {
        "default": "en-US",
        "fr": "fr",
    },
}
